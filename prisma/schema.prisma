// Skema database Golden Donate Cash
// Dev: SQLite (gampang, tanpa setup). Production: ganti provider ke "postgresql"
// dan DATABASE_URL ke koneksi Postgres (mis. dari Supabase / Neon / Railway).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  name        String
  avatar      String?
  isSuperOwner Boolean @default(false)
  createdAt   DateTime @default(now())
  workspaces  Workspace[]
}

model Workspace {
  id         String    @id @default(cuid())
  name       String
  slot       Int       @default(1)
  archived   Boolean   @default(false)
  apiKey     String    @unique
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  providers  Provider[]
  donations  Donation[]
  boardConfig BoardConfig?
  settings    WorkspaceSettings?

  createdAt  DateTime  @default(now())
}

// Satu baris per integrasi (Saweria / Bagi-Bagi / Sociabuzz) per workspace
model Provider {
  id          String   @id @default(cuid())
  type        String   // "saweria" | "bagibagi" | "sociabuzz"
  enabled     Boolean  @default(false)
  webhookToken String  @unique @default(cuid())
  streamKey   String?  // khusus Saweria
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, type])
}

model Donation {
  id          String    @id @default(cuid())
  donorName   String
  amount      Int
  message     String?
  provider    String
  status      String    @default("pending") // pending | claimed
  leaseToken  String?   // dipegang Roblox selama diproses, dilepas kalau ack gagal
  leaseExpiresAt DateTime?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
}

// Koneksi Roblox Open Cloud untuk Board donatur (satu per workspace).
// apiKeyEnc = API key Open Cloud yang dienkripsi (AES-256-GCM) dengan BOARD_SECRET_KEY.
model BoardConfig {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  universeId    String
  topStoreName  String
  nameStoreName String?
  apiKeyEnc     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Pengaturan efek dan notifikasi per workspace, diatur dari website dan dibaca oleh server game.
// data = JSON yang sudah divalidasi (lihat lib/settings.js). version naik setiap kali disimpan.
model WorkspaceSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  data        Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
